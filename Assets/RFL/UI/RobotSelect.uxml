<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Theme.uss" />
    <ui:VisualElement class="screen select-screen">
        <RFL.Game.UI.LocLabel name="title" key="ui.select.title" class="screen-title" />
        <ui:VisualElement name="cards" class="cards" />
        <ui:VisualElement class="slots">
            <ui:VisualElement name="slot-p1" class="slot slot-p1">
                <RFL.Game.UI.LocLabel name="head" class="slot-head" />
                <ui:Label name="device" class="slot-device" />
                <ui:VisualElement class="slot-line">
                    <RFL.Game.UI.LocLabel name="state" class="slot-state" />
                    <RFL.Game.UI.LocLabel name="ready" key="ui.select.ready" class="slot-ready" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="slot-p2" class="slot slot-p2">
                <RFL.Game.UI.LocLabel name="head" class="slot-head" />
                <ui:Label name="device" class="slot-device" />
                <ui:VisualElement class="slot-line">
                    <RFL.Game.UI.LocLabel name="state" class="slot-state" />
                    <RFL.Game.UI.LocLabel name="ready" key="ui.select.ready" class="slot-ready" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
